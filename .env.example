# Copiar como .env y completar. El archivo .env NUNCA se sube a GitHub.

# --- Base de datos ---
POSTGRES_DB=proyecto_empleo
POSTGRES_USER=empleo
POSTGRES_PASSWORD=cambiar_por_una_clave_larga
DATABASE_URL=postgresql+psycopg://empleo:cambiar_por_una_clave_larga@db:5432/proyecto_empleo

# --- Aplicacion ---
DOMINIO=proyectoempleo.duckdns.org
ZONA_HORARIA=America/Bogota
# Obligatorio: genere uno con `openssl rand -hex 32` (la app no arranca con el valor de ejemplo)
JWT_SECRETO=cambiar_por_texto_aleatorio_largo
JWT_HORAS=72

# --- IA ---
IA_PROVEEDOR=groq
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest

# --- Fuentes de vacantes ---
JOOBLE_API_KEY=
JOOBLE_HOST=jooble.org
CAREERJET_API_KEY=
CAREERJET_LOCALE=es_CO
CAREERJET_USER_IP=

# --- Correo de alertas (IMAP) ---
IMAP_SERVIDOR=imap.gmail.com
IMAP_USUARIO=dstogether01@gmail.com
IMAP_CLAVE_APLICACION=

# --- Operacion (opcional) ---
# Aviso si la actualizacion diaria no corre: cree un "check" gratis en https://healthchecks.io
# (periodo 1 dia, gracia 1 hora) y pegue aqui su URL de ping.
HEALTHCHECK_URL=
# Copias de seguridad: clave de cifrado (openssl rand -hex 32). Guardela TAMBIEN fuera del servidor:
# sin ella los respaldos no se pueden abrir.
RESPALDO_CLAVE=
# Destino externo de rclone, p. ej. b2:proyecto-empleo-respaldos (Backblaze B2, 10 GB gratis). Vacio = solo local.
RESPALDO_DESTINO=
